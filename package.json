{
  "name": "nan2026-slime-shift",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:pages": "node tools/build-github-pages.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "tsc --outDir .test-dist --module NodeNext --moduleResolution NodeNext --target ES2022 --skipLibCheck --noEmit false game/core.ts game/cli.ts tests/game.test.ts && node --test .test-dist/tests/game.test.js",
    "simulate": "tsc --outDir .simulate-dist --module NodeNext --moduleResolution NodeNext --target ES2022 --skipLibCheck --noEmit false game/core.ts game/cli.ts && node .simulate-dist/cli.js",
    "map:edit": "node tools/map-editor.mjs",
    "map:check": "node tools/map-editor.mjs --check",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "balance:edit": "node tools/balance-editor.mjs",
    "balance:check": "node tools/balance-editor.mjs --check"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "phaser": "3.90.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260517.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
